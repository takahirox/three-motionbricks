{
  "name": "three-motionbricks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:pages": "node scripts/check-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "assets:model": "node scripts/download-model.mjs",
    "assets:mmd": "tsx scripts/prepare-mmd.ts",
    "check:mmd-ik": "tsx scripts/compare-mmd-ik.ts",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "ammojs-typed": "1.0.6",
    "mmd-gltf": "https://codeload.github.com/takahirox/mmd-gltf/tar.gz/3dfa726aa38992a1f7d5ea17b377c685e839e8b8",
    "onnxruntime-web": "1.31.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "three": "$three"
  }
}
